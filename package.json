{
    "name": "chefcookie",
    "version": "3.1.1",
    "main": "./_build/script.js",
    "module": "./_build/script.mjs",
    "exports": {
        ".": {
            "import": "./_build/script.mjs",
            "require": "./_build/script.js"
        },
        "./chefcookie.min.js": "./chefcookie.min.js",
        "./package.json": "./package.json"
    },
    "files": [
        "_build/*.js",
        "_build/*.mjs",
        "chefcookie.min.js"
    ],
    "repository": {
        "type": "git",
        "url": "git+ssh://git@github.com/vielhuber/chefcookie.git"
    },
    "author": "David Vielhuber <david@vielhuber.de>",
    "license": "MIT",
    "description": "",
    "scripts": {
        "js:vite": "vite build --logLevel error",
        "js:minify": "terser --compress --mangle --comments false --output ./chefcookie.min.js ./chefcookie.min.js",
        "js:package": "vite build --logLevel error --mode package",
        "js": "npm-run-all2 --sequential js:vite js:minify js:package",
        "js:dev": "npm-run-all2 --sequential js:vite js:package",
        "watch:js": "onchange ./_js/*.js --initial --poll 50 --delay 0 --await-write-finish 50 -- npm run js:dev",
        "dev": "npm-run-all2 --parallel watch:*",
        "prod": "npm-run-all2 --parallel js",
        "start": "vite --host 0.0.0.0 --port 18080 --strictPort",
        "build": "npm run prod",
        "test": "npm run cypress:test",
        "cypress:test": "start-server-and-test start http://localhost:18080/_tests/index.html 'npx cypress run'",
        "cypress:open": "start-server-and-test start http://localhost:18080/_tests/index.html 'cypress open'"
    },
    "dependencies": {
        "cookie": "^2.0.1",
        "onchange": "^7.1.0"
    },
    "devDependencies": {
        "@prettier/plugin-php": ">=0.25",
        "cypress": "^16.0.0",
        "npm-run-all2": "^9.0.3",
        "prettier": ">=3",
        "start-server-and-test": "^3.0.12",
        "terser": "^5.51.2",
        "vite": "^8.2.2"
    },
    "overrides": {
        "@babel/core": "^7.29.7",
        "form-data": "^4.0.6",
        "qs": "^6.15.2",
        "shell-quote": "^1.8.4",
        "systeminformation": "^5.31.7",
        "tmp": "^0.2.7",
        "uuid": "^11.1.1"
    },
    "browserslist": [
        "> 0.25%",
        "not dead",
        "not ie 11"
    ],
    "engines": {
        "node": ">=20"
    },
    "allowScripts": {
        "cypress": true
    }
}
